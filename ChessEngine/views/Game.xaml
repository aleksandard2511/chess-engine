<Window Background="#FF846328" x:Class="ChessEngine.views.Game"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessEngine.views"
        mc:Ignorable="d"
        Title="Game" Height="1000" Width="1200" MinHeight="900" MinWidth="1100" VerticalAlignment="Center" HorizontalAlignment="Center"
        WindowStartupLocation="CenterScreen">
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1500"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock Name="tbBlackTime" FontSize="30" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Margin="20,100"></TextBlock>
        <TextBlock Name="tbWhiteTime" FontSize="30" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.Column="1" Margin="20,100"></TextBlock>
        <Button Grid.Column="1" Height="70" Width="80" Content="Resign" VerticalAlignment="Center" HorizontalAlignment="Center"  Background="#db5439" Cursor="Hand" Click="ResignButton_Click" FontSize="14"></Button>
    </Grid>
</Window>
