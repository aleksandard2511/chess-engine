<Window x:Class="ChessEngine.views.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessEngine.views"
        mc:Ignorable="d"
        Title="Settings" Height="450" Width="800"
        MaxHeight="450" MaxWidth="800"
        MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Level: " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="0" Margin="50 0 0 0"></TextBlock>
        <RadioButton Name="Level1" GroupName="Level" IsChecked="True" Content="Beginner" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 300 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <RadioButton Name="Level2" GroupName="Level" Content="Intermiediate" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <RadioButton Name="Level3" GroupName="Level" Content="Advanced" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300 0 0 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <TextBlock Text="Color: " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="1" Margin="50 0 0 0"></TextBlock>
        <RadioButton Name="ColorWhite" GroupName="Color" IsChecked="True" Content="White" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 300 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <RadioButton Name="ColorBlack" GroupName="Color" Content="Black" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300 0 0 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <TextBlock Text="Time Control: " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" Margin="50 0 0 0"></TextBlock>
        <RadioButton Name="Time1" GroupName="Time" IsChecked="True" Content="3+2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 300 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <RadioButton Name="Time2" GroupName="Time" Content="5+3" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <RadioButton Name="Time3" GroupName="Time" Content="10+5" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300 0 0 0" FontSize="20" VerticalContentAlignment="Center" Cursor="Hand"></RadioButton>
        <Button Grid.Row="4" Height="50" Width="100" FontSize="22" Content="Play" Background="#FF349643" Cursor="Hand" Click="PlayButton_Click"></Button>

    </Grid>
</Window>
