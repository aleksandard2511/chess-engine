<Window x:Class="ChessEngine.views.GameOver"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessEngine.views"
        mc:Ignorable="d"
        Title="GameOver" Height="500" Width="500"
        MinHeight="500" MinWidth="500"
        MaxHeight="500" MaxWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#f0b581">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250"></RowDefinition>
            <RowDefinition Height="250"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Name="tbGameOver" Text="Game over!" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"></TextBlock>
        <Button Height="80" Width="80" Content="Play again" Grid.Row="1" HorizontalAlignment="Left" Margin="100,0" Background="#a2ed85" Cursor="Hand" Click="PlayAgainButton_Click" FontSize="16"></Button>
        <Button Height="80" Width="80" Content="Exit" Grid.Row="1" HorizontalAlignment="Right" Margin="100,0" Click="ExitButton_Click" Background="#db6451" Cursor="Hand" FontSize="16"></Button>
    </Grid>
</Window>
